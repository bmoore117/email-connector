# Your Gmail address
GMAIL_USER=you@gmail.com

# App password from Google Account > Security > 2-Step Verification > App passwords
# Generate one scoped to "Mail" — do NOT use your real Gmail password
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# The Gmail label to fetch from. Emails in this label are treated as event sources.
# Create the label in Gmail and set up a filter to auto-label emails from your private groups.
GMAIL_LABEL=miami-social-event-source

# Comma-separated list of Luma calendar slugs (e.g. FTLYR,hello_miami) to directly fetch
# upcoming events from. This broadens the connector beyond just Gmail emails.
LUMA_CALENDARS=FTLYR,hello_miami,labmiami,delphica

# All output files (upcoming_events.json, past_events.json, connector.log, etc.) live in ./run/
# (gitignored). Agent instructions are loaded from hermes/agent-prompt.txt unless overridden:
# HERMES_AGENT_PROMPT_PATH=/path/to/prompt.txt

# Hermes webhook (same host). POST body: instructions, hasErrors, newEvents, health.
# Omitted vars default when enabled:
#   HERMES_WEBHOOK_URL=http://127.0.0.1:8644/webhooks/luma-events
#   HERMES_WEBHOOK_SECRET=INSECURE_NO_AUTH  (match route secret in ~/.hermes/config.yaml)
# Set HERMES_WEBHOOK_ENABLED=false to write upcoming-delta.json without POSTing
HERMES_WEBHOOK_ENABLED=true
